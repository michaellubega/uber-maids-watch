# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
LOG_LEVEL=INFO

# Deployment (Render).  When DATABASE_URL is set it takes precedence over the
# individual DB_* values below; Render injects it from the Blueprint database.
# DATABASE_URL=postgres://user:password@host:5432/database
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# PostgreSQL (default). Use DB_ENGINE=sqlite only for a throw-away local demo.
DB_ENGINE=postgresql
DB_NAME=ubermaids
DB_USER=ubermaids
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432


# Private document storage (outside the public media tree).
# Leave blank to use <backend>/private_media.
PRIVATE_MEDIA_ROOT=

# Browser origins allowed to call the API (Flutter web development only).
CORS_ALLOWED_ORIGINS=

# Business rules pending owner confirmation.
GUARANTEE_DAYS_DEFAULT=14
FOLLOW_UP_WINDOW_DAYS_DEFAULT=7
MAX_DOCUMENT_BYTES=5242880

# Render API key for optional deployment automation. Never commit a real key.
RENDER_API_KEY=
